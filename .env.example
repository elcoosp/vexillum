# vexillum-server — dashboard GitHub OAuth (all optional; the login wall
# stays closed with a friendly setup hint until these are present).
#
# 1. Create an OAuth App at https://github.com/settings/developers
#      Homepage URL:      http://localhost:5173
#      Callback URL:      http://localhost:5173/v1/auth/github/callback
#    (in development the Vite dev server proxies /v1 to :8080, so the app
#     registers the VITE origin, not the API port)
# 2. Copy the client id/secret here and restart `vexillum-server`.
# 3. Open http://localhost:5173/login — "Continue with GitHub" goes live.

# OAuth app credentials from https://github.com/settings/developers
VX_GITHUB_CLIENT_ID=
VX_GITHUB_CLIENT_SECRET=

# Web frontend origin (the callback is derived from it by default)
VX_PUBLIC_URL=http://localhost:5173

# Override only when the API lives on its own domain, e.g.
# https://api.vexillum.dev/v1/auth/github/callback
# VX_OAUTH_REDIRECT_URI=

# Shared GitHub token pool for the github/* data services (comma-separated).
# Optional — the services stay rate-limited-but-working without it.
# VX_GITHUB_TOKENS=ghp_xxx,ghp_yyy

# --- Hardening knobs (all optional) --------------------------------------
# CORS origin allowlist (comma-separated, bare hosts or full origins).
# Empty = reflect any origin with credentials (legacy posture). Pinning the
# dashboard origin is recommended in production:
#   VX_CORS_ORIGINS=https://vexillum.dev,https://app.vexillum.dev
# VX_CORS_ORIGINS=

# Trust X-Forwarded-For for per-IP anonymous metering. Enable ONLY when the
# server sits behind a reverse proxy that OVERWRITES the chain (nginx/Caddy/
# Cloudflare) — otherwise the header is spoofable and is ignored by default.
# VX_TRUST_PROXY=1

# Stripe webhook signing secret (enables POST /v1/billing/webhook, which
# upgrades/downgrades API-key tiers from checkout + subscription events).
# VX_STRIPE_WEBHOOK_SECRET=whsec_xxx
