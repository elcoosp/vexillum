{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", "out/**"] },
    "test": { "dependsOn": ["^build"], "outputs": [] },
    "compile": { "dependsOn": ["^build"], "outputs": ["out/**", "../../crates/templates/assets/**"] },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] }
  }
}
